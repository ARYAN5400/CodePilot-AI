# Copy to .env only for local development. Never commit real values.
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:5173
API_BASE_URL=http://localhost:8000
GITHUB_CLIENT_ID=replace-with-github-app-client-id
GITHUB_CLIENT_SECRET=replace-with-github-app-client-secret
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=codepilot
FERNET_KEY=generate-a-dedicated-fernet-key
SESSION_TTL_SECONDS=28800
STATE_TTL_SECONDS=600
